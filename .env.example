# =============================================================
# .env.example · PLANTILLA versionada, sin valores reales
#
# Este archivo SÍ se sube a Git: le dice a quien llega qué
# variables debe definir. El archivo .env, con los valores
# reales, NO se sube nunca (está en .gitignore).
#
# Uso:
#   cp .env.example .env
#   y luego edite .env con sus propios valores.
# =============================================================

# --- Base de datos PostgreSQL --------------------------------
POSTGRES_DB=ideam
POSTGRES_USER=ideam_app
# Defina una contraseña propia. No reutilice contraseñas reales:
# este entorno es local y de desarrollo.
POSTGRES_PASSWORD=cambieme

# --- Puertos en el equipo anfitrión --------------------------
# Cámbielos si algo ya ocupa esos puertos en su máquina.
JUPYTER_PORT=8888
POSTGRES_PORT_HOST=5432
