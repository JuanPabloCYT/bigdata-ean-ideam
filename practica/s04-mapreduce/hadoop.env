# Configuracion compartida del cluster HDFS + YARN para T4.

# --- HDFS -------------------------------------------------------
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
# Replicacion 1: la tolerancia a fallos no es el objeto de esta
# sesion (se demostro en S03). Con un solo nodo de datos, ademas,
# un factor mayor que 1 dejaria bloques bajo-replicados sin remedio.
HDFS_CONF_dfs_replication=1
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# --- YARN ---------------------------------------------------------
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
# Obligatorio para que las tareas reductoras puedan leer la salida
# de las tareas de mapeo durante la mezcla. Sin esto, YARN levanta
# pero todo trabajo Map-Reduce se queda colgado en la fase de mezcla.
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle
YARN_CONF_yarn_nodemanager_aux___services_mapreduce_shuffle_class=org.apache.hadoop.mapred.ShuffleHandler
# Pool total de memoria que este unico nodemanager ofrece para
# contenedores (el maestro de aplicacion, las tareas de mapa y de
# reduccion). Calibrado para caber en los 3,83 GB de la VM de Docker
# de este equipo, no es un valor de referencia para produccion.
YARN_CONF_yarn_nodemanager_resource_memory___mb=1024
YARN_CONF_yarn_scheduler_minimum___allocation___mb=128
YARN_CONF_yarn_scheduler_maximum___allocation___mb=768
# Los chequeos de memoria virtual y fisica de YARN son agresivos bajo
# emulacion amd64-sobre-arm64: el arranque de cada JVM hija puede
# picar de memoria un instante y YARN mata el contenedor por una
# falsa alarma. Se desactivan y se confia en los limites de heap de
# cada tarea (mapreduce.*.java.opts, mas abajo) como guardarraya real.
YARN_CONF_yarn_nodemanager_vmem___check___enabled=false
YARN_CONF_yarn_nodemanager_pmem___check___enabled=false
YARN_CONF_yarn_log___aggregation___enable=false

# --- MapReduce ------------------------------------------------------
MAPRED_CONF_mapreduce_framework_name=yarn
# Sin esto, el maestro de aplicacion y las tareas de mapa/reduccion
# fallan al arrancar con "Could not find or load main class
# org.apache.hadoop.mapreduce.v2.app.MRAppMaster": no encuentran la
# distribucion de Hadoop en su classpath porque la variable no viaja
# al entorno de los contenedores YARN que YARN mismo lanza.
MAPRED_CONF_yarn_app_mapreduce_am_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_map_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_reduce_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
MAPRED_CONF_mapreduce_map_memory_mb=256
MAPRED_CONF_mapreduce_reduce_memory_mb=256
MAPRED_CONF_mapreduce_map_java_opts=-Xmx204m
MAPRED_CONF_mapreduce_reduce_java_opts=-Xmx204m
MAPRED_CONF_yarn_app_mapreduce_am_resource_mb=256
MAPRED_CONF_yarn_app_mapreduce_am_command___opts=-Xmx204m
# Fuerza varias tareas de mapeo sobre un archivo de ~21 MB (que en un
# solo bloque de 128 MB produciria una sola tarea). Con divisiones de
# 4 MB se obtienen unas 6 tareas de mapeo, lo suficiente para que la
# diferencia entre "con combinador" y "sin combinador" sea observable
# y para que el combinador se ejecute mas de una vez, como ocurriria
# en un clip real con varios nodos.
MAPRED_CONF_mapreduce_input_fileinputformat_split_maxsize=4194304
