        <mxCell id="ef" value="sk_fecha" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=none;startArrow=none;strokeColor=#0E5CAD;" edge="1" parent="1" source="dimfecha" target="hechos">
