# Configuracion compartida del cluster HDFS
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
HDFS_CONF_dfs_replication=3
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
# Deteccion de nodos caidos mas rapida, solo para la practica.
# Por defecto HDFS tarda 2*recheck(5min)+10*latido(3s) = 10,5 min en
# declarar muerto un nodo. En este equipo medi 531 s reales. Con estos
# valores el tiempo baja a 2*15s+10*3s = 60 s, para poder observar la
# caida y la re-replicacion dentro de una sesion de trabajo.
HDFS_CONF_dfs_namenode_heartbeat_recheck___interval=15000
HDFS_CONF_dfs_heartbeat_interval=3
